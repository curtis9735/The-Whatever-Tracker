# ---------------------------------------------------------------------------
# Portainer stack variables (Stacks → your stack → Environment variables)
# ---------------------------------------------------------------------------

# Image tag to run (ghcr.io/curtis9735/the-whatever-tracker): latest, or a release like 0.1.0
TAG=latest

# The public URL you will open the app at, through the reverse proxy. Must match exactly.
ORIGIN=https://tracker.example.com

# Your DSM user and group IDs (SSH into the NAS and run `id`). 1026:100 is the usual first DSM user.
PUID=1026
PGID=100

# NAS port the container is published on (the reverse proxy forwards to this)
HOST_PORT=8765

# With DSM's built-in reverse proxy, set this to 127.0.0.1 so the port above only answers on the
# NAS itself and every visitor has to come through the proxy (HTTPS, real client IPs for the
# sign-in limits). Leave it out if your proxy runs on another machine or in another container.
# HOST_IP=127.0.0.1

# Folder on the NAS for the database, photos and backups. Create it first in File Station.
DATA_PATH=/volume1/docker/whatever-tracker

# Your time zone, e.g. America/Chicago or Europe/Berlin. Days are split at the server's local midnight: it
# decides which day a log, and each imported last.fm play, lands on. Without it the server runs on UTC,
# which can push an evening's logs onto tomorrow, so set it to yours.
# TZ=

# ---------------------------------------------------------------------------
# Metadata sources (all optional; each one switches on when its key is set).
# Admins can also enter these in the app under Me → Integrations, which takes priority.
# ---------------------------------------------------------------------------

# Movies & TV: free at https://www.themoviedb.org/settings/api
# Either the v3 "API Key" or the v4 "API Read Access Token" works.
TMDB_API_KEY=

# Video games: create an app at https://dev.twitch.tv/console/apps (category: Application Integration)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Board games: register an app at https://boardgamegeek.com/applications and create a token.
# BGG reviews applications by hand, which can take a week or more.
BGG_API_TOKEN=

# Concert setlists: free key at https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=

# Albums & listening history: free API key (any name and description, no callback URL) at
# https://www.last.fm/api/account/create. Only the API key is used, not the shared secret.
LASTFM_API_KEY=

# Artists & albums: MusicBrainz needs no key, but asks every app for contact info
# (an email address or a URL) that is sent in the User-Agent header.
MUSICBRAINZ_CONTACT=

# ---------------------------------------------------------------------------
# Local development only (npm run dev): put these in a file named .env
# ---------------------------------------------------------------------------
# DATA_DIR=./data
